{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/designs.ts": {
      "includeFiles": "{src/lib/**,data/designs.json}"
    },
    "api/designs/[id]/vote.ts": {
      "includeFiles": "{src/lib/**,data/designs.json}"
    }
  }
}
