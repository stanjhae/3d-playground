# Copy to .env.local. Local values come from `supabase start` (API_URL and
# PUBLISHABLE_KEY). Never put the service-role or secret key in a VITE_ var:
# everything prefixed VITE_ ships to the browser.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
# true = /create requires sign-in and publishing never falls back to a guest
# post. Off until My Studio (#149) and cloud save (#172) land.
VITE_FLP_REQUIRE_AUTH=false

# Server-only (dev API reads these from .env.local; Vercel sets them as
# project env vars). Never prefix with VITE_.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# true = show concept garments (gown, slip, coat, suit) in the studio.
# The MVP studio is the canonical tee only (E01 #152).
VITE_FLP_CONCEPT=false

# Where reports of shared designs and account-deletion requests go (Q10
# #195). Public: it is shown on /privacy and in report links. Unset = the
# app says reporting is not open yet.
VITE_FLP_CONTACT_EMAIL=
