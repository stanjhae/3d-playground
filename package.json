{
  "name": "fashion-leader-vote",
  "private": true,
  "version": "0.9.0-rc.7",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "generate": "node scripts/generate-routes.mjs",
    "garments": "node scripts/build-jacket.mjs",
    "tee": "node scripts/build-tee.mjs",
    "graphics": "node scripts/build-graphics.mjs",
    "stills": "node scripts/bake-stills.mjs",
    "og": "node scripts/bake-og.mjs",
    "build": "pnpm generate && tsc --noEmit && vite build && node scripts/prerender-landing.mjs",
    "poster": "node scripts/bake-landing-poster.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:integration": "FLP_INTEGRATION=1 vitest run integration --testTimeout=20000",
    "e2e": "playwright test",
    "hosted:check": "node scripts/hosted-check.mjs",
    "demo:preflight": "node scripts/demo-preflight.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.8",
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/outfit": "^5.2.8",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-router": "^1.170.46",
    "lucide-react": "^1.68.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "web-vitals": "^6.2.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "4.4.2",
    "@gltf-transform/extensions": "4.4.2",
    "@gltf-transform/functions": "4.4.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-generator": "^1.168.0",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "draco3dgltf": "^1.5.9",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "meshoptimizer": "^1.3.0",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.7",
    "vitest": "^4.1.4"
  }
}
