{
  "name": "fashion-leader-vote",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @flv/web dev",
    "dev:admin": "pnpm --filter @flv/admin dev",
    "build": "pnpm --filter @flv/web build",
    "build:admin": "pnpm --filter @flv/admin build",
    "preview": "pnpm --filter @flv/web preview",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm --filter @flv/web test:integration",
    "e2e": "pnpm --filter @flv/web e2e",
    "hosted:check": "pnpm --filter @flv/web hosted:check",
    "demo:preflight": "pnpm --filter @flv/web demo:preflight",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck"
  }
}
